# Copy to .env for local dev. Never commit real values.

# RAG service (services/rag)
RAG_SERVICE_URL=http://localhost:8000
# Shared secret sent as x-internal-key; must match RAG_API_KEY on the RAG side
# (mandatory when RAG is reachable from the internet, e.g. the Vercel demo).
RAG_API_KEY=
# Vercel demo: 1 = show a labelled stored example when RAG is unreachable.
DEMO_FALLBACK=

# Serverless demo (Vercel without a VPS): AI answers from the bundled NIST
# SP 800-61r2 index. Same names as the VPS RAG service. Leave LLM_PROVIDER
# empty to disable. Keys stay server-side (never PUBLIC_).
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=
# Empty LLM_MODEL = cheapest tier (claude-haiku-5-5 / gemini-flash-lite-latest).
# Fallbacks, comma-separated, tried in order when the model is overloaded or
# missing. Gemini always ends with gemini-flash-lite-latest, gemini-flash-latest.
LLM_FALLBACK_MODEL=
LLM_EFFORT=low
RATE_LIMIT_PER_MINUTE=10
RATE_LIMIT_PER_DAY=100
DAILY_SPEND_CAP_USD=
# Upstash for Redis via the Vercel Marketplace sets these two (REST, not redis://):
# shared rate limit / spend cap / answer cache across serverless instances.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Lets admins change the model on "API & Kunci" without a redeploy: the API
# key typed there is encrypted with this before it goes to Redis. Random,
# 16+ chars (openssl rand -base64 32). Changing it means re-entering the key.
SETTINGS_SECRET=

# Firebase — admin auth (PRD.md §9 K-02).
# FIREBASE_PROJECT_ID and ADMIN_UIDS are server-side only, but neither is a
# secret by itself (a project ID is public; UIDs are opaque identifiers, not
# credentials) — verification needs no service-account file, see
# src/lib/server/firebase-auth.ts for why.
FIREBASE_PROJECT_ID=REPLACE_WITH_FIREBASE_PROJECT_ID
ADMIN_UIDS=REPLACE_WITH_COMMA_SEPARATED_UIDS

# Public Firebase client config — NOT secret, safe to expose to the browser.
# From Firebase console > Project settings > General > Your apps > Web app.
PUBLIC_FIREBASE_API_KEY=REPLACE
PUBLIC_FIREBASE_AUTH_DOMAIN=REPLACE.firebaseapp.com
PUBLIC_FIREBASE_PROJECT_ID=REPLACE_WITH_FIREBASE_PROJECT_ID
