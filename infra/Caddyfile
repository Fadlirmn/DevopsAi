# Used by infra/compose.yaml. DOMAIN=:80 -> plain HTTP on any host (local);
# DOMAIN=knowledge.example.com -> automatic HTTPS (VPS, DNS must point here).
{$DOMAIN:knowledge.example.com} {
    encode zstd gzip
    header {
      X-Content-Type-Options nosniff
      Referrer-Policy strict-origin-when-cross-origin
      X-Frame-Options DENY
    }
    # Everything goes through the SvelteKit BFF (it owns /api/v1/* and the
    # admin auth check). The FastAPI RAG service must NOT be routed here: it
    # has no auth of its own and is only reachable on the internal network.
    reverse_proxy web:3000
}
