# Fill on VPS; do not commit actual secrets. Set chmod 600.
DOMAIN=knowledge.example.com
NODE_ENV=production
APP_ENV=production
POSTGRES_DB=knowledgeops
POSTGRES_USER=knowledgeops_app
POSTGRES_PASSWORD=REPLACE_WITH_LONG_RANDOM_VALUE
DATABASE_URL=postgresql://knowledgeops_app:REPLACE_WITH_LONG_RANDOM_VALUE@db:5432/knowledgeops
FIREBASE_PROJECT_ID=REPLACE
ADMIN_UIDS=REPLACE_UID
# FIREBASE_CREDENTIALS_PATH is NOT read by the current admin-auth
# implementation (apps/web/src/lib/server/firebase-auth.ts verifies ID
# tokens against Google's public JWKS + FIREBASE_PROJECT_ID only, no service
# account needed). Kept here for a future feature that does need the Admin
# SDK (e.g. revoking tokens).
FIREBASE_CREDENTIALS_PATH=/run/secrets/firebase-admin.json
LLM_API_KEY=REPLACE
EMBEDDING_API_KEY=REPLACE
STORAGE_BUCKET=REPLACE_PRIVATE_BUCKET
STORAGE_ENDPOINT=REPLACE_PRIVATE_ENDPOINT
STORAGE_ACCESS_KEY=REPLACE
STORAGE_SECRET_KEY=REPLACE
PUBLIC_DEMO_DAILY_QUOTA=REPLACE_TBD
DAILY_SPEND_CAP_USD=REPLACE_TBD
MAX_UPLOAD_MB=15
RATE_LIMIT_STORE_URL=REPLACE_REDIS_OR_DB_URL
PIPELINE_VERSION=v1
# Quota/cap values are not decided — set from real traffic/budget, don't guess.
# JWT audience / secure cookie secret must be added after interface decisions.
