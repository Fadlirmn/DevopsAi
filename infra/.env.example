# Copy to infra/.env (gitignored) and fill in. On a VPS: chmod 600 infra/.env.
# Same file shape for local and VPS — only these values differ.

# --- Domain / ports -----------------------------------------------------------
# Local:  DOMAIN=:80  (plain HTTP)   + HTTP_PORT=8080 if 80 is taken -> http://localhost:8080
# VPS:    DOMAIN=knowledge.example.com (DNS A/AAAA -> VPS) + HTTP_PORT=80 HTTPS_PORT=443
DOMAIN=:80
HTTP_PORT=8080
HTTPS_PORT=8443

# --- Postgres -----------------------------------------------------------------
# Used inside a URL, so keep the password URL-safe: `openssl rand -hex 32`.
POSTGRES_DB=knowledgeops
POSTGRES_USER=knowledgeops_app
POSTGRES_PASSWORD=REPLACE_WITH_openssl_rand_hex_32

# --- Firebase admin auth (PRD.md §9 K-02) ---------------------------------------
# Not secrets (project ID and UIDs are identifiers). Left empty, /admin simply
# stays locked (fails closed) — the public demo still works.
FIREBASE_PROJECT_ID=
ADMIN_UIDS=
PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=
PUBLIC_FIREBASE_PROJECT_ID=

# --- AI provider (dipilih lewat env; restart setelah ganti) --------------------
# LLM_PROVIDER:       mock | anthropic | openai | gemini | openai-compatible
# EMBEDDING_PROVIDER: mock | openai | gemini | openai-compatible
#   (Anthropic tidak punya API embedding — pasangkan dengan provider lain.)
# mock = tanpa API key, jawaban template; cocok untuk mencoba alur & UI.
LLM_PROVIDER=mock
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=
LLM_EFFORT=low
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
# Contoh (pilih satu, hapus komentar):
#  Claude + embedding OpenAI:
#   LLM_PROVIDER=anthropic         LLM_API_KEY=sk-ant-...   (LLM_MODEL default: claude-haiku-5-5, tier termurah)
#   EMBEDDING_PROVIDER=openai      EMBEDDING_API_KEY=sk-...  (default text-embedding-3-small @768)
#  OpenAI penuh:
#   LLM_PROVIDER=openai  LLM_MODEL=<model chat OpenAI>  LLM_API_KEY=sk-...
#   EMBEDDING_PROVIDER=openai      (EMBEDDING_API_KEY ikut LLM_API_KEY bila kosong)
#  Gemini penuh:
#   LLM_PROVIDER=gemini  LLM_MODEL=<model Gemini>  LLM_API_KEY=...
#   EMBEDDING_PROVIDER=gemini      (default gemini-embedding-001 @768)
#  Ollama lokal (gratis), dari dalam Docker:
#   LLM_PROVIDER=openai-compatible  LLM_MODEL=llama3.1  LLM_BASE_URL=http://host.docker.internal:11434/v1
#   EMBEDDING_PROVIDER=openai-compatible  EMBEDDING_MODEL=nomic-embed-text
# Setelah ganti EMBEDDING_*: jalankan ulang embed —
#   docker compose -f infra/compose.yaml run --rm seed python scripts/seed_corpus.py --reembed

# --- Rate limit & biaya (PRD K-08) ---------------------------------------------
# Per IP pengunjung, disimpan di Postgres. Admin yang login tidak dibatasi.
RATE_LIMIT_PER_MINUTE=10
RATE_LIMIT_PER_DAY=100
# Batas biaya AI harian (USD). Kalau tercapai, pertanyaan baru ditolak (503)
# sampai besok; jawaban dari cache tetap jalan. Kosong = tanpa batas.
# Harga Claude sudah diketahui; provider lain isi LLM_PRICE_*_PER_MTOK.
DAILY_SPEND_CAP_USD=
LLM_PRICE_INPUT_PER_MTOK=
LLM_PRICE_OUTPUT_PER_MTOK=

# Pertanyaan di luar topik: kalau tidak ada potongan dokumen dengan kemiripan
# (cosine) >= nilai ini, ditolak tanpa memanggil AI (hemat biaya). Kosong = tanpa
# ambang (AI tetap wajib mengutip dokumen; jawaban tanpa kutipan selalu ditolak).
# Nilainya tergantung model embedding — kalibrasi dengan pertanyaan asli.
RETRIEVAL_MIN_SIMILARITY=

# --- Dokumen awal (seed) -------------------------------------------------------
# all  = semua seed corpus (NIST, CISA, Kubernetes, PostgreSQL) — default Docker
# demo = hanya NIST SP 800-61r2 — untuk demo Vercel
SEED_SET=all

# --- Kunci internal BFF -> RAG ---------------------------------------------------
# Wajib untuk mode Vercel (RAG dibuka ke internet); disarankan selalu diisi.
# openssl rand -hex 32. Isi nilai yang sama di env Vercel.
RAG_API_KEY=
# Hanya untuk compose.vercel.yaml: hostname publik RAG API (DNS -> VPS).
RAG_DOMAIN=

# --- Belum dipakai (milestone berikutnya, PRD.md §7/§9) -------------------------
# STORAGE_BUCKET= / STORAGE_ENDPOINT= / STORAGE_ACCESS_KEY= / STORAGE_SECRET_KEY=
# MAX_UPLOAD_MB=15
